{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kirolos-portfolio-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-25",
  "observability": {
    "enabled": true
  },
  "vars": {
    "FRONTEND_ORIGIN": "https://kirolos.dev",
    "GITHUB_CALLBACK_URL": "https://kirolos-portfolio-api.linc-ministry.workers.dev/api/auth/github/callback"
  },
  "ai": {
    "binding": "AI"
  },
  "vectorize": [
    {
      "binding": "RAG_INDEX",
      "index_name": "portfolio-career-rag-cloudflare-v1"
    }
  ],
  "ratelimits": [
    {
      "name": "RAG_RATE_LIMITER",
      "namespace_id": "26083101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kirolos-portfolio-db",
      "database_id": "68f1f658-cf8e-4e12-b5e2-5b925130cf52",
      "migrations_dir": "migrations"
    }
  ]
}
