{
  "name": "kirolos-dev-portfolio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src shared worker scripts vite.config.ts --max-warnings=0",
    "typecheck": "npm run typecheck:app && npm run typecheck:worker",
    "typecheck:app": "tsc -p tsconfig.app.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dev": "wrangler dev",
    "worker:dry-run": "wrangler deploy --dry-run --outdir dist-worker",
    "worker:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply kirolos-portfolio-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply kirolos-portfolio-db --remote",
    "verify": "npm run check:legacy && npm run lint && npm run typecheck && npm run test && npm run worker:dry-run",
    "milestone": "node scripts/milestone-cli.mjs",
    "r2:create": "wrangler r2 bucket create kirolos-portfolio-assets",
    "cleanup:legacy": "node scripts/cleanup-legacy.mjs",
    "check:legacy": "node scripts/check-no-legacy.mjs"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260821.1",
    "@eslint/js": "10.9.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "globals": "17.11.0",
    "netlify-cli": "27.3.0",
    "typescript": "6.0.0",
    "typescript-eslint": "8.67.0",
    "vite": "7.1.3",
    "vitest": "4.1.10",
    "wrangler": "4.125.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
